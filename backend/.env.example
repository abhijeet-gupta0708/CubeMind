# Comma-separated list of allowed browser origins.
# Include your Vercel production URL, e.g. https://cubemind.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Solver search budget. The two-phase search normally finishes in under 3s.
SOLVER_TIME_LIMIT=20
SOLVER_NODE_LIMIT=4000000

# Optional path for the generated solver cache (default backend/.cache).
# KOCIEMBA_TABLES_PATH=/var/data/kociemba_tables.pkl

# Maximum camera image payload accepted by /scan/detect (bytes).
MAX_IMAGE_BYTES=8388608

LOG_LEVEL=info
