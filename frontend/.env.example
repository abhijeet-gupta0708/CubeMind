# Leave empty in development: Vite proxies /api to http://127.0.0.1:8000.
# In production, set this to the deployed API origin (no trailing slash).
# Example: https://cubemind-api.onrender.com
VITE_API_URL=

# Optional: override the dev proxy target (useful when running the API elsewhere).
# VITE_DEV_API_PROXY=http://127.0.0.1:8000
